# Copie este archivo a .env y ajuste los valores. NO suba .env al repositorio.
# Todos los valores de abajo son de ejemplo (sin secretos reales).

# --- Base de datos (docker-compose usa estas variables para crear PostgreSQL) ---
POSTGRES_USER=medinova
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_DB=medinova
DATABASE_URL=postgresql+psycopg2://medinova:cambiar_esta_clave@db:5432/medinova

# --- Aplicación ---
APP_ENV=development
PORT=8000
ZONA_HORARIA=America/Monterrey
RELOJ_SIMULABLE=true      # solo demo: habilita PUT /demo/reloj (en producción real: false)
SEED_DEMO=true            # carga sucursales, médicos y pacientes ficticios para la demo

# --- Reglas configurables del negocio ---
TOLERANCIA_MINUTOS=15           # BRD: tolerancia por retraso
DURACION_CITA_MINUTOS=30        # duración de cada franja ofrecida en la disponibilidad
NOSHOW_UMBRAL=3                 # decisión del equipo (pendiente de aprobación de dirección)
CONFIRMACION_LIMITE_HORAS=24    # US-21: horas sin confirmar antes de liberar el horario
WHATSAPP_MODO=simulado          # simulado | desactivado (la API real requiere credenciales)
